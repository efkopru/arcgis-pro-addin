<controls:ProWindow x:Class="MultipleLeaders.CalloutOptionsWindow" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
    Title="Create shared label" Width="530" SizeToContent="Height"
    ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
    Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Connect several points to one label" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                 Text="Example: select three buildings, enter Buildings, then click where that single label should appear."/>
      <Canvas Height="74" Margin="0,12,0,0" IsHitTestVisible="False"
              AutomationProperties.Name="Example: three points connected by lines to one Buildings label">
        <Path Data="M 25,10 L 165,37 M 25,37 L 165,37 M 25,64 L 165,37"
              Stroke="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" StrokeThickness="1.2"/>
        <Ellipse Canvas.Left="21" Canvas.Top="6" Width="8" Height="8" Fill="#007AC2"/>
        <Ellipse Canvas.Left="21" Canvas.Top="33" Width="8" Height="8" Fill="#007AC2"/>
        <Ellipse Canvas.Left="21" Canvas.Top="60" Width="8" Height="8" Fill="#007AC2"/>
        <TextBlock Canvas.Left="174" Canvas.Top="25" Text="Buildings" FontSize="16"/>
      </Canvas>
      <TextBlock x:Name="SelectionText" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <Label Grid.Row="1" Content="Label text" Target="{Binding ElementName=LabelBox}" Padding="0" Margin="0,20,0,6"/>
    <TextBox Grid.Row="2" x:Name="LabelBox" Height="78" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="500"
             Padding="8" VerticalScrollBarVisibility="Auto" TextChanged="InputChanged" AutomationProperties.Name="Label text"/>
    <Grid Grid.Row="3" Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="FieldBox" MinHeight="30" Margin="0,0,8,0" AutomationProperties.Name="Shared label field"/>
      <Button Grid.Column="1" x:Name="FieldButton" Content="Use shared value" Padding="10,5" Click="SharedFieldClick"/>
    </Grid>
    <Grid Grid.Row="4" Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Label Content="Font (pt)" Target="{Binding ElementName=FontBox}" Padding="0,0,10,0" VerticalAlignment="Center"/>
        <TextBox x:Name="FontBox" Text="10" Width="62" Padding="6" TextChanged="InputChanged" AutomationProperties.Name="Font size in points"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <Label Content="Line (pt)" Target="{Binding ElementName=WidthBox}" Padding="0,0,10,0" VerticalAlignment="Center"/>
        <TextBox x:Name="WidthBox" Text="0.75" Width="62" Padding="6" TextChanged="InputChanged" AutomationProperties.Name="Leader line width in points"/>
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="5" Margin="0,18,0,0" TextWrapping="Wrap"
               Text="Next, click once on the map to place the label. Esc or Cancel Placement stops the tool. The result is a graphic in the Multiple Leaders layer. Hide that layer to hide the result; use Undo to remove a new label. Source points stay unchanged."/>
    <StackPanel Grid.Row="6" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="Firebrick"
               AutomationProperties.LiveSetting="Assertive"/>
    </StackPanel>
    <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="CreateButton" Content="Next: place on map" Padding="14,7" Margin="0,0,8,0" Click="CreateClick" IsDefault="True"/>
      <Button x:Name="CancelButton" Content="Cancel" Padding="14,7" IsCancel="True" Click="CancelClick"/>
    </StackPanel>
  </Grid>
</controls:ProWindow>
