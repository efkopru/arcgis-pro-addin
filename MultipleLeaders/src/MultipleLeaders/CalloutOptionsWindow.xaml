<controls:ProWindow x:Class="MultipleLeaders.CalloutOptionsWindow" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
    Title="Create shared label" Width="560" SizeToContent="Height"
    ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
    Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,6,0">
        <TextBlock Text="1. Set up your shared label" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Margin="0,8,0,0" Text="Then click once on the map to place it. Each distinct point gets a leader line." TextWrapping="Wrap"/>
        <Border Margin="0,12,0,0" Padding="10" BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
          <TextBlock x:Name="SelectionText" TextWrapping="Wrap"/>
        </Border>
        <Label Content="_Label text" Target="{Binding ElementName=LabelBox}" Padding="0" Margin="0,16,0,5"/>
        <TextBox x:Name="LabelBox" Height="68" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="500"
                 Padding="8" VerticalScrollBarVisibility="Auto" TextChanged="InputChanged" AutomationProperties.Name="Label text"/>
        <TextBlock x:Name="CharacterCountText" HorizontalAlignment="Right" Margin="0,3,0,0" FontSize="11"/>
        <Label Content="Use a common attribute value (optional)" Target="{Binding ElementName=FieldBox}" Padding="0" Margin="0,6,0,5"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ComboBox x:Name="FieldBox" MinHeight="30" Margin="0,0,8,0" AutomationProperties.Name="Shared label field"/>
          <Button Grid.Column="1" x:Name="FieldButton" Content="Use shared value" Padding="10,5" Click="SharedFieldClick"/>
        </Grid>
        <TextBlock x:Name="FieldStatusText" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel>
            <Label Content="_Font size (6-72 pt)" Target="{Binding ElementName=FontBox}" Padding="0,0,0,5"/>
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="FontBox" Width="60" Padding="6" TextChanged="InputChanged" AutomationProperties.Name="Font size in points"/>
              <Button Content="10" Tag="10" Margin="6,0,0,0" Padding="6,3" Click="FontPresetClick" ToolTip="10-point text"/>
              <Button Content="12" Tag="12" Margin="4,0,0,0" Padding="6,3" Click="FontPresetClick" ToolTip="12-point text"/>
              <Button Content="18" Tag="18" Margin="4,0,0,0" Padding="6,3" Click="FontPresetClick" ToolTip="18-point text"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <Label Content="Leader _width (0.1-5 pt)" Target="{Binding ElementName=WidthBox}" Padding="0,0,0,5"/>
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="WidthBox" Width="60" Padding="6" TextChanged="InputChanged" AutomationProperties.Name="Leader line width in points"/>
              <Button Content="Thin" Tag="0.5" Margin="6,0,0,0" Padding="6,3" Click="WidthPresetClick" ToolTip="0.5-point leader lines"/>
              <Button Content="Bold" Tag="1.5" Margin="4,0,0,0" Padding="6,3" Click="WidthPresetClick" ToolTip="1.5-point leader lines"/>
            </StackPanel>
          </StackPanel>
        </Grid>
        <TextBlock Text="STYLE PREVIEW" FontSize="11" FontWeight="SemiBold" Margin="0,16,0,5"/>
        <Border BorderThickness="1" Padding="8"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
          <Grid Height="86" IsHitTestVisible="False" ClipToBounds="True">
            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Canvas AutomationProperties.Name="Illustrative leader lines, not a map preview">
              <Path x:Name="PreviewLeaders" Data="M 12,10 L 120,43 M 12,43 L 120,43 M 12,76 L 120,43"
                    Stroke="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" StrokeThickness="1"/>
              <Ellipse Canvas.Left="8" Canvas.Top="6" Width="8" Height="8" Fill="#007AC2"/>
              <Ellipse Canvas.Left="8" Canvas.Top="39" Width="8" Height="8" Fill="#007AC2"/>
              <Ellipse Canvas.Left="8" Canvas.Top="72" Width="8" Height="8" Fill="#007AC2"/>
            </Canvas>
            <TextBlock x:Name="PreviewLabel" Grid.Column="1" FontFamily="Arial" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="86"/>
          </Grid>
        </Border>
        <TextBlock Text="Style sample only. Final appearance depends on map scale. Your size choices are remembered during this Pro session."
                   FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Margin="0,14,0,0">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Assertive"/>
      <TextBlock Text="Esc cancels placement. Use Manage Labels later to move, resize, or reconnect a label. Hide its graphics layer to hide the result."
                 TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CreateButton" Content="2. Place on map" Padding="14,7" Margin="0,0,8,0" Click="CreateClick" IsDefault="True"/>
        <Button x:Name="CancelButton" Content="Cancel" Padding="14,7" IsCancel="True" Click="CancelClick"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</controls:ProWindow>
