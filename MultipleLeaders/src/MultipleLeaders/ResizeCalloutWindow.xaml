<controls:ProWindow x:Class="MultipleLeaders.ResizeCalloutWindow" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
    Title="Resize label" Width="450" SizeToContent="Height"
    ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
    Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Change the selected label's text size. Its position and leader widths stay the same."
               TextWrapping="Wrap"/>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
      <Label Content="Font size (points)" Target="{Binding ElementName=FontBox}"
             VerticalAlignment="Center" Padding="0,0,12,0"/>
      <TextBox x:Name="FontBox" Width="90" Padding="6" TextChanged="InputChanged"
               AutomationProperties.Name="Font size in points"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="0,12,0,0">
      <WrapPanel>
        <Button Content="10 pt" Tag="10" Padding="10,5" Margin="0,0,6,0" Click="PresetClick"/>
        <Button Content="12 pt" Tag="12" Padding="10,5" Margin="0,0,6,0" Click="PresetClick"/>
        <Button Content="18 pt" Tag="18" Padding="10,5" Margin="0,0,6,0" Click="PresetClick"/>
        <Button Content="24 pt" Tag="24" Padding="10,5" Click="PresetClick"/>
      </WrapPanel>
      <TextBlock x:Name="ChangeText" Margin="0,10,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
    <Border Grid.Row="3" Height="118" Margin="0,14,0,0" Padding="10" BorderThickness="1"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" ClipToBounds="True">
      <TextBlock x:Name="PreviewText" Text="Shared label" FontFamily="Arial" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </Border>
    <TextBlock Grid.Row="4" x:Name="ErrorText" Margin="0,12,0,0" FontWeight="SemiBold"
               TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="ResizeButton" Content="Resize label" Padding="14,7" Margin="0,0,8,0"
              IsDefault="True" Click="ResizeClick"/>
      <Button Content="Cancel" Padding="14,7" IsCancel="True"/>
    </StackPanel>
  </Grid>
</controls:ProWindow>
