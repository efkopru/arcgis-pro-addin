<controls:ProWindow x:Class="MultipleLeaders.CalloutManagerWindow" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
    Title="Manage shared labels" Width="820" Height="490" MinWidth="660" MinHeight="400"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
    Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Choose a shared label" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1" x:Name="InstructionText" TextWrapping="Wrap" Margin="0,8,0,16"
               Text="Choose a row to move its text, resize it, or reconnect its leaders. You do not need to select a graphic in the map first."/>
    <DataGrid Grid.Row="2" x:Name="LabelsGrid" AutoGenerateColumns="False" IsReadOnly="True"
              SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False"
              SelectionChanged="SelectionChanged" RowHeaderWidth="0" HeadersVisibility="Column"
              AutomationProperties.Name="Shared labels in the active map">
      <DataGrid.Resources>
        <Style x:Key="CellText" TargetType="TextBlock">
          <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
          <Setter Property="Margin" Value="4,3"/>
          <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
      </DataGrid.Resources>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Label text" Binding="{Binding Text}" Width="2*" MinWidth="180" ElementStyle="{StaticResource CellText}"/>
        <DataGridTextColumn Header="Source layer" Binding="{Binding Source}" Width="*" MinWidth="140" ElementStyle="{StaticResource CellText}"/>
        <DataGridTextColumn Header="Points" Binding="{Binding PointCount}" Width="58" ElementStyle="{StaticResource CellText}"/>
        <DataGridTextColumn Header="Graphics layer" Binding="{Binding GraphicsLayer}" Width="*" MinWidth="140" ElementStyle="{StaticResource CellText}"/>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="3" x:Name="SelectionStatus" TextWrapping="Wrap" Margin="0,10,0,0"
               AutomationProperties.LiveSetting="Polite"/>
    <StackPanel Grid.Row="4" Margin="0,10,0,0">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock x:Name="ErrorText" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
    </StackPanel>
    <Grid Grid.Row="5" Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="MoveButton" Content="Move label" Padding="12,7" Margin="0,0,8,0" Click="MoveClick" IsEnabled="False"/>
        <Button x:Name="ResizeButton" Content="Resize label" Padding="12,7" Margin="0,0,8,0" Click="ResizeClick" IsEnabled="False"/>
        <Button x:Name="ReconnectButton" Content="Reconnect leaders" Padding="12,7" Click="ReconnectClick" IsEnabled="False"/>
      </StackPanel>
      <Button Grid.Column="1" Content="Close" Padding="16,7" IsCancel="True"/>
    </Grid>
  </Grid>
</controls:ProWindow>
