<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ArcGISProInstallDir Condition="'$(ArcGISProInstallDir)' == ''">$(ProgramW6432)\ArcGIS\Pro</ArcGISProInstallDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\MultipleLeaders\CalloutGraphicBuilder.cs" Link="CalloutGraphicBuilder.cs" />
    <Compile Include="..\..\src\MultipleLeaders\CalloutInput.cs" Link="CalloutInput.cs" />
    <Compile Include="..\..\src\MultipleLeaders\PlacementLifetime.cs" Link="PlacementLifetime.cs" />
    <Compile Include="..\..\src\MultipleLeaders\PlacementExitScheduler.cs" Link="PlacementExitScheduler.cs" />
    <Reference Include="ArcGIS.Core">
      <HintPath>$(ArcGISProInstallDir)\bin\ArcGIS.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
