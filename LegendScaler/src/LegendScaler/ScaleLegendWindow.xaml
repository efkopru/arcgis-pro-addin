<controls:ProWindow x:Class="LegendScaler.ScaleLegendWindow" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
    Title="Resize legend" Width="530" SizeToContent="Height"
    MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
    ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
    Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,8,0">
    <TextBlock Text="Resize a legend" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
               Text="Change text, spacing, symbol patches, and frame together. The legend stays linked to its map."/>
    <TextBlock x:Name="SelectionText" Margin="0,12,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
    <StackPanel x:Name="InputPanel">
      <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
        <Label Content="Size (%)" Target="{Binding ElementName=PercentBox}" VerticalAlignment="Center" Padding="0,0,14,0"/>
        <TextBox x:Name="PercentBox" Text="125" Width="96" Padding="8,5" TextChanged="PercentChanged"
                 AutomationProperties.Name="Size percentage"/>
        <TextBlock Text="10 to 1,000%" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <WrapPanel Margin="0,10,0,0" AutomationProperties.Name="Common sizes">
        <Button Content="50%" Tag="50" Padding="11,5" Margin="0,0,6,0" Click="PresetClick" ToolTip="Half the current size"/>
        <Button Content="75%" Tag="75" Padding="11,5" Margin="0,0,6,0" Click="PresetClick"/>
        <Button Content="100%" Tag="100" Padding="11,5" Margin="0,0,6,0" Click="PresetClick" ToolTip="Same size, useful for making a copy"/>
        <Button Content="125%" Tag="125" Padding="11,5" Margin="0,0,6,0" Click="PresetClick"/>
        <Button Content="150%" Tag="150" Padding="11,5" Margin="0,0,6,0" Click="PresetClick"/>
        <Button Content="200%" Tag="200" Padding="11,5" Click="PresetClick" ToolTip="Double the current size"/>
      </WrapPanel>
      <TextBlock x:Name="ChangeText" Margin="0,10,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock x:Name="DimensionsText" Margin="0,6,0,0" TextWrapping="Wrap"/>
      <TextBlock Text="Apply to" Margin="0,20,0,8" FontWeight="SemiBold"/>
      <RadioButton x:Name="CopyOption" GroupName="Output" Content="A new copy (keep the original)" IsChecked="True"
                   Checked="DestinationChanged" Padding="0,2"/>
      <RadioButton x:Name="OriginalOption" GroupName="Output" Content="The selected legend" Margin="0,8,0,0"
                   Checked="DestinationChanged" Padding="0,2"/>
      <TextBlock x:Name="DestinationText" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <Expander x:Name="ScopeExpander" Header="What to check in the result" Margin="0,14,0,0">
      <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="ScopeText" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="Map-symbol sizes and complex effects may need adjustment. Fixed font sizes may change column wrapping."/>
      </ScrollViewer>
    </Expander>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1">
    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap"
               Text="Use layout Undo (Ctrl+Z) to reverse the change. Close or Esc exits."/>
    <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock x:Name="ErrorText" Margin="0,6,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
               AutomationProperties.LiveSetting="Assertive"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="ApplyButton" Content="Create scaled copy" MinWidth="152" Padding="12,7" Margin="0,0,8,0"
              Click="ApplyClick" IsDefault="True"/>
      <Button x:Name="CloseButton" Content="Close" Padding="12,7" IsCancel="True" Click="CloseClick"/>
    </StackPanel>
    </StackPanel>
  </Grid>
</controls:ProWindow>
