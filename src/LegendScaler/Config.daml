<?xml version="1.0" encoding="utf-8"?>
<ArcGIS xmlns="http://schemas.esri.com/DADF/Registry"
        defaultAssembly="LegendScaler.dll"
        defaultNamespace="LegendScaler">
  <AddInInfo id="{B014FA99-86BC-4649-995C-307437D30D10}" version="0.1.0" desktopVersion="3.7">
    <Name>Legend Scaler</Name>
    <Description>Scale a selected layout legend proportionally while preserving its connection to the map.</Description>
    <Author>Legend Scaler contributors</Author>
    <Date>2026-09-28</Date>
    <Subject>Layout legend scaling</Subject>
  </AddInInfo>
  <modules>
    <insertModule id="LegendScaler_Module" className="LegendScalerModule" autoLoad="false" caption="Legend Scaler">
      <tabs>
        <tab id="LegendScaler_Tab" caption="Legend Tools" keytip="LT">
          <group refID="LegendScaler_Group" />
        </tab>
      </tabs>
      <groups>
        <group id="LegendScaler_Group" caption="Scale" keytip="S" appearsOnAddInTab="false">
          <button refID="LegendScaler_ScaleLegendButton" size="large" />
        </group>
      </groups>
      <controls>
        <button id="LegendScaler_ScaleLegendButton" className="ScaleLegendButton"
                caption="Scale Legend" keytip="SL" loadOnClick="true">
          <tooltip heading="Scale Legend">Set a percentage for the selected legend's text, patches, spacing, and frame.</tooltip>
        </button>
      </controls>
    </insertModule>
  </modules>
</ArcGIS>
